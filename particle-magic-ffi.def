; Windows module definition file for the C ABI shared library
; (func-spec 0009 §4.3). GHC exports a foreign library's Haskell entry
; points only when it is told which ones -- without this list the DLL
; links, loads, and resolves nothing, which is a linker error in someone
; else's engine rather than a failure here. Kept in step with the
; `foreign export` list by test/FFIContractSpec.hs.
; The pm_hs_* symbols the Haskell exports now carry are deliberately
; absent: they are the inside of the I3 gate (host-runtime F003), not part
; of the ABI, and Windows keeps them invisible for free.
EXPORTS
    pm_init
    pm_init_ex
    pm_shutdown
    pm_abi_version
    pm_cast
    pm_cast_ex
    pm_advance
    pm_advance_ex
    pm_is_finished
    pm_age
    pm_observe
    pm_observe_ex
    pm_free
    pm_max_particles
    pm_project
    pm_depth_order
    pm_scene_new
    pm_scene_free
    pm_scene_cast
    pm_scene_cast_many
    pm_scene_dismiss
    pm_scene_advance
    pm_scene_advance_ex
    pm_scene_observe
    pm_scene_budget
    pm_scene_count
    pm_scene_spells
    pm_spell_bounds
    pm_spell_box
    pm_emitter_count
    pm_emitter_box
    pm_occupancy
    pm_occupancy_mask
    pm_scene_spell_bounds
    pm_plan_steps
