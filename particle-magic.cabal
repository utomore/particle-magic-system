cabal-version:      3.4
name:               particle-magic
version:            0.1.0.0
synopsis:           Particle magic system proof-of-concept
description:
    A pure-core, data-driven particle magic system: magic circles are
    Haskell ADTs (JSON-serializable) compiled into deterministic particle
    emitters. The public libraries (magic-core, magic-boundary) are
    renderer- and engine-agnostic; this repo's executable is an h-raylib
    demo shell. Host games depend on particle-magic:magic-boundary and
    consume Magic.Interface / Magic.Codec only.
license:            MIT
license-file:       LICENSE
maintainer:         utomore@outlook.com
category:           Graphics
build-type:         Simple
extra-doc-files:    README.md
                    CHANGELOG.md

source-repository head
    type:     git
    location: https://github.com/utomore/particle-magic-system.git

-- Architecture boundary is enforced by this package structure
-- (func-spec 0001 §3, guarded by test/BoundarySpec.hs):
--   * magic-core: pure core, build-depends whitelist {base, vector, deepseq}
--   * magic-boundary: pure boundary layer (JSON codec, public interface)
--   * executable: effectful shell; depends on magic-boundary ONLY,
--     so it physically cannot import core internals.

library magic-core
    visibility:       public
    hs-source-dirs:   src/core
    exposed-modules:  Magic.Types
                      Magic.Particle.Buffer
                      Magic.Rune
                      Magic.Circle
                      Magic.Compile
                      Magic.Particle.Analytic
                      Magic.Project
                      Magic.Expr
    build-depends:    base     ^>=4.22
                    , vector   ^>=0.13
                    , deepseq  ^>=1.5
    default-language: GHC2021
    ghc-options:      -Wall -O2

library magic-boundary
    visibility:       public
    hs-source-dirs:   src/boundary
    exposed-modules:  Magic.Codec
                      Magic.Interface
                      Magic.Projection
                      Magic.Step
                      Magic.Expr.Parse
    build-depends:    base                 ^>=4.22
                    , particle-magic:magic-core
                    , aeson                ^>=2.3
                    , bytestring           ^>=0.12
                    , text                 ^>=2.1
                    , megaparsec           ^>=9.8
                    , parser-combinators   ^>=1.3
    default-language: GHC2021
    ghc-options:      -Wall -O2

executable particle-magic
    main-is:          Main.hs
    hs-source-dirs:   app
    other-modules:    App.Effects
                    , App.HotReload
                    , App.Loop
                    , App.TestInterp
                    , App.Render.Raylib3D
                    , App.Render.Quads
                    , App.Render.Flat
                    , App.Hud
    build-depends:    base
                    , particle-magic:magic-boundary
                    , h-raylib
                    , effectful
                    , bytestring
                    , vector
                    , directory
                    , time
                    , containers
    default-language: GHC2021
    ghc-options:      -Wall -threaded -O2

test-suite spec
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    -- app/ is included so the loop + interpreters are tested as-built;
    -- the raylib-touching modules (Main, App.Render.Raylib3D) are NOT
    -- listed, keeping the test suite headless and h-raylib-free.
    hs-source-dirs:   test, app
    other-modules:    BoundarySpec
                    , TypesSpec
                    , CircleSpec
                    , CircleCodecSpec
                    , ShapeSpec
                    , EnvelopeSpec
                    , CompileCoreSpec
                    , CompileFoldSpec
                    , SampleSpec
                    , Acceptance2Spec
                    , BufferSpec
                    , CodecSpec
                    , PipelineSpec
                    , StepSpec
                    , EffectsSpec
                    , HotReloadSpec
                    , AcceptanceSpec
                    , ExprGen
                    , ExprEvalSpec
                    , ExprParseSpec
                    , ExprRenderSpec
                    , ExprGoldenSpec
                    , CompileExprSpec
                    , RuneCodecSpec
                    , SampleExprSpec
                    , Acceptance4Spec
                    , StepObserveSpec
                    , QuadBatchSpec
                    , SceneEffectsSpec
                    , ReloadStatusSpec
                    , HudSpec
                    , SpellSwitchSpec
                    , OptFlagsSpec
                    , Acceptance5Spec
                    , PhasePlanSpec
                    , PhaseCodecSpec
                    , CompileLifecycleSpec
                    , FormationSpec
                    , PhaseSampleSpec
                    , BackCompatSpec
                    , Acceptance6Spec
                    , ProjectSpec
                    , FlatQuadSpec
                    , FlatEffectsSpec
                    , ViewToggleSpec
                    , Acceptance8Spec
                    , App.Effects
                    , App.HotReload
                    , App.Loop
                    , App.TestInterp
                    , App.Render.Quads
                    , App.Render.Flat
                    , App.Hud
    build-depends:    base
                    , particle-magic:magic-core
                    , particle-magic:magic-boundary
                    , hspec
                    , QuickCheck
                    , bytestring
                    , vector
                    , effectful
                    , directory
                    , time
                    , containers
                    , text
    build-tool-depends: hspec-discover:hspec-discover
    default-language: GHC2021
    ghc-options:      -Wall -threaded

-- Baseline measurements for the future throughput spec (func-spec 0005
-- §8 S8). A separate stanza so it is outside the library/executable
-- whitelist BoundarySpec guards, and h-raylib-free: all it measures is
-- pure code.
benchmark bench
    type:             exitcode-stdio-1.0
    main-is:          Bench.hs
    hs-source-dirs:   bench, app
    other-modules:    App.Render.Quads
    build-depends:    base
                    , particle-magic:magic-boundary
                    , tasty-bench
                    , bytestring
                    , vector
    default-language: GHC2021
    ghc-options:      -Wall -O2
