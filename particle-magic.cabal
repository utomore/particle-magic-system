                    , FFIProjectSpec
                    , BindingContractSpec
                    , Acceptance11Spec
                    , CameraSpec
                    , OrderSpec
                    , FlatCameraSpec
                    , DepthTintSpec
                    , Acceptance13Spec
                    , CapacitySpec
                    , ComposeSpec
                    , ComposeBudgetSpec
                    , SceneSpec
                    , Acceptance12Spec
                    , Validate
                    , ValidateSpec
                    , SchemaDocSpec
                    , RescanSpec
                    , Acceptance14Spec
                    , BatchSplitSpec
                    , ShapeVocabSpec
                    , SpriteSpec
                    , Acceptance15Spec
                    , SigilGen
                    , SigilHashSpec
                    , SigilStrokeSpec
                    , SigilPlanSpec
                    , SigilWiringSpec
                    , Acceptance16Spec
                    , PersistEnvelopeSpec
                    , PersistWiringSpec
                    , Acceptance17Spec
                    , FFISceneSpec
                    , FFISceneCastSpec
                    , Acceptance18Spec
                    , GoldenPlatform
                    , CIWorkflowSpec
                    , ReleaseMetaSpec
                    , ReleaseDocSpec
                    , SigilSpinSpec
                    , SigilMotionSpec
                    , SigilMotionWiringSpec
                    , Acceptance20Spec
                    , ElementVocabSpec
