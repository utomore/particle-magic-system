-- Baseline measurements for the future throughput spec (func-spec 0005
-- §8 S8). A separate stanza so it is outside the library/executable
-- whitelist BoundarySpec guards, and h-raylib-free: all it measures is
-- pure code.
benchmark bench
    type:             exitcode-stdio-1.0
    main-is:          Bench.hs
    hs-source-dirs:   bench, app
    other-modules:    App.Render.Quads
    -- magic-core is reachable from here (and only from here): func-spec
    -- 0010 S8 measures the 10k-100k range, which is past 'budgetCap', so
    -- the synthetic fixtures are built as 'CompiledSpell' values directly
    -- instead of going through 'compile'. The sampler itself never
    -- consults the cap, so this measures the real code path -- and the
    -- benchmark stanza is outside the dependency whitelist BoundarySpec
    -- guards precisely so a measuring instrument can reach further than a
    -- shipped component may.
    build-depends:    base        ^>=4.22
                    , particle-magic:magic-core
                    , particle-magic:magic-boundary
                    , tasty-bench ^>=0.5
                    , bytestring  ^>=0.12
                    , vector      ^>=0.13
    default-language: GHC2021
    ghc-options:      -Wall -O2
