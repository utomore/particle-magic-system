cabal-version:      3.4
name:               particle-magic
-- Four segments, PVP. The release policy lives in docs/release.md and
-- ADR-0016; the short version is that magic-core and magic-boundary are
-- public sublibraries, so a breaking change to a frozen interface is a
-- major bump, and the git tag is 'v' ++ this string. PM_ABI_VERSION in
-- include/particle_magic.h is deliberately NOT tied to this number: the
-- header is add-only, so the two generations move independently.
-- test/ReleaseMetaSpec.hs keeps this in step with CHANGELOG.md.
version:            0.1.0.0
-- The compilers this has actually been built and tested with, not the
-- ones it might work with. Must equal the GHC version CI installs
-- (.github/workflows/ci.yml), which ReleaseMetaSpec asserts.
tested-with:        GHC ==9.14.1
synopsis:           Particle magic system proof-of-concept
description:
    A pure-core, data-driven particle magic system: magic circles are
    Haskell ADTs (JSON-serializable) compiled into deterministic particle
    emitters. The public libraries (magic-core, magic-boundary) are
    renderer- and engine-agnostic; this repo's executable is an h-raylib
    demo shell. Host games depend on particle-magic:magic-boundary and
    consume Magic.Interface / Magic.Codec only.
license:            MIT
license-file:       LICENSE
maintainer:         utomore@outlook.com
category:           Graphics
build-type:         Simple
extra-doc-files:    README.md
                    CHANGELOG.md
-- The C ABI contract and its example host (func-spec 0009): shipped so a
-- non-Haskell consumer gets the header and a working reference host.
-- The C# reference binding joins them in func-spec 0011: same purpose,
-- next language along (test/BindingContractSpec.hs keeps it in step with
-- the header).
-- examples/haskell/ joins them in enhance-0001, closing the odd gap that
-- the two non-native routes had runnable proof and the native one did
-- not. It is a package of its own (not a stanza below) precisely so it
-- consumes this one from the outside; test/ExampleHostSpec.hs asserts
-- that every file of it is listed here.
extra-source-files: include/particle_magic.h
                    examples/c/main.c
                    examples/c/scene.c
                    bindings/csharp/ParticleMagic.cs
                    examples/haskell/Main.hs
                    examples/haskell/particle-magic-example.cabal
                    examples/haskell/cabal.project
                    examples/haskell/expected-output.txt
                    examples/haskell/README.md

source-repository head
    type:     git
    location: https://github.com/utomore/particle-magic-system.git

-- Architecture boundary is enforced by this package structure
-- (func-spec 0001 §3, guarded by test/BoundarySpec.hs):
--   * magic-core: pure core, build-depends whitelist {base, vector, deepseq}
--   * magic-boundary: pure boundary layer (JSON codec, public interface)
--   * executable: effectful shell; depends on magic-boundary ONLY,
--     so it physically cannot import core internals.

library magic-core
    visibility:       public
    hs-source-dirs:   src/core
    exposed-modules:  Magic.Types
                      Magic.Particle.Buffer
                      Magic.Rune
                      Magic.Circle
                      Magic.Sigil
                      Magic.Compile
                      Magic.Space
                      Magic.Particle.Analytic
                      Magic.Particle.Field
                      Magic.Project
                      Magic.Expr
    build-depends:    base     ^>=4.22
                    , vector   ^>=0.13
                    , deepseq  ^>=1.5
    default-language: GHC2021
    ghc-options:      -Wall -O2

library magic-boundary
    visibility:       public
    hs-source-dirs:   src/boundary
    exposed-modules:  Magic.Codec
                      Magic.Interface
                      Magic.Projection
                      Magic.Step
                      Magic.Expr.Parse
                      Magic.Columns
                      Magic.Scene
    -- 'vector' joins the boundary layer in func-spec 0007: Magic.Interface
    -- feeds the force-field layer per-slot inputs and adds its
    -- displacements onto the sampled SoA buffer. Already inside the
    -- whitelist test/BoundarySpec.hs guards.
    build-depends:    base                 ^>=4.22
                    , particle-magic:magic-core
                    , vector               ^>=0.13
                    , aeson                ^>=2.3
                    , bytestring           ^>=0.12
                    , text                 ^>=2.1
                    , megaparsec           ^>=9.8
                    , parser-combinators   ^>=1.3
    default-language: GHC2021
    ghc-options:      -Wall -O2

executable particle-magic
    main-is:          Main.hs
    hs-source-dirs:   app
    other-modules:    App.Effects
                    , App.HotReload
                    , App.Loop
                    , App.TestInterp
                    , App.Camera
                    , App.Render.Raylib3D
                    , App.Render.Quads
                    , App.Render.Flat
                    , App.Render.Order
                    , App.Render.Chunk
                    , App.Render.Sprite
                    , App.Hud
    build-depends:    base       ^>=4.22
                    , particle-magic:magic-boundary
                    , h-raylib   ^>=5.6
                    , effectful  ^>=2.6
                    , bytestring ^>=0.12
                    , vector     ^>=0.13
                    , directory  ^>=1.3
                    , filepath   ^>=1.5
                    , time       ^>=1.15
                    , containers ^>=0.8
    default-language: GHC2021
    ghc-options:      -Wall -threaded -O2

-- The boundary layer's third consumer (func-spec 0014): an authoring
-- tool that loads and casts a spell file and reports what happened. It
-- opens no window and draws nothing, which is the point -- the same
-- dependency discipline as the demo executable (magic-core is NOT
-- reachable, and neither is a renderer), guarded by test/BoundarySpec.hs.
-- 'aeson' is here because the tool reads the two circle-level opt-in keys
-- (phases, fields) back off Magic.Codec's own canonical encoding.
executable magic-validate
    main-is:          Main.hs
    hs-source-dirs:   tools
    other-modules:    Validate
    build-depends:    base       ^>=4.22
                    , particle-magic:magic-boundary
                    , aeson      ^>=2.3
                    , bytestring ^>=0.12
                    , vector     ^>=0.13
                    , directory  ^>=1.3
    default-language: GHC2021
    ghc-options:      -Wall -O2

-- The second supported consumption mode (ADR-0011, func-spec 0009): the
-- same boundary layer behind a C ABI, so non-Haskell hosts (Unity, Godot,
-- a C/C++ engine) can drive the spell lifecycle and render the six SoA
-- columns themselves. Shell-layer component, same discipline as the
-- executable: magic-core is NOT reachable from here, only the public
-- boundary plus the two marshalling libraries its signatures are written
-- in (bytestring for loadCircle's input, vector for the buffer's columns).
-- Guarded by test/FFIContractSpec.hs.
foreign-library particle-magic-ffi
    type:             native-shared
    if os(windows)
        options:      standalone
        -- Without an explicit export list the DLL links but resolves
        -- nothing for a host; see the .def file's own note.
        mod-def-file: particle-magic-ffi.def
    hs-source-dirs:   src/ffi
    other-modules:    Magic.FFI
    c-sources:        cbits/pm_init.c
    include-dirs:     include
    install-includes: particle_magic.h
    build-depends:    base       ^>=4.22
                    , particle-magic:magic-boundary
                    , bytestring ^>=0.12
                    , vector     ^>=0.13
    default-language: GHC2021
    ghc-options:      -Wall -O2 -threaded

test-suite spec
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    -- app/ is included so the loop + interpreters are tested as-built;
    -- the raylib-touching modules (Main, App.Render.Raylib3D) are NOT
    -- listed, keeping the test suite headless and h-raylib-free.
    -- src/ffi is included so the C ABI shell is tested in-process: the
    -- foreign-exported functions are ordinary Haskell functions, called
    -- here through real CStrings and Ptrs (func-spec 0009 §2). Loading the
    -- built shared object is the manual smoke, §8 S6.
    -- tools/ joins them in func-spec 0014 for the same reason app/ is
    -- here: the CLI's pure half is tested as-built. tools/Main.hs (the IO
    -- shell) is not listed, so no second 'Main' module is compiled in.
    hs-source-dirs:   test, app, src/ffi, tools
    other-modules:    BoundarySpec
                    , TypesSpec
                    , CircleSpec
                    , CircleCodecSpec
                    , ShapeSpec
                    , EnvelopeSpec
                    , CompileCoreSpec
                    , CompileFoldSpec
                    , SampleSpec
                    , Acceptance2Spec
                    , BufferSpec
                    , CodecSpec
                    , PipelineSpec
                    , StepSpec
                    , EffectsSpec
                    , HotReloadSpec
                    , AcceptanceSpec
                    , ExprGen
                    , ExprEvalSpec
                    , ExprParseSpec
                    , ExprRenderSpec
                    , ExprGoldenSpec
                    , CompileExprSpec
                    , RuneCodecSpec
                    , SampleExprSpec
                    , Acceptance4Spec
                    , StepObserveSpec
                    , QuadBatchSpec
                    , SceneEffectsSpec
                    , ReloadStatusSpec
                    , HudSpec
                    , SpellSwitchSpec
                    , OptFlagsSpec
                    , Acceptance5Spec
                    , PhasePlanSpec
                    , PhaseCodecSpec
                    , CompileLifecycleSpec
                    , FormationSpec
                    , PhaseSampleSpec
                    , BackCompatSpec
                    , Acceptance6Spec
                    , FFIHarness
                    , FFILifecycleSpec
                    , FFIObserveSpec
                    , FFIErrorSpec
                    , FFIContractSpec
                    , Acceptance9Spec
                    , Magic.FFI
